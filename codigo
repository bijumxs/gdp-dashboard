/* =====================================================
   APLICA FILTROS
===================================================== */

function applyFilters(){

    const start =
        document
            .getElementById(
                "dateStart"
            )
            .value;


    const end =
        document
            .getElementById(
                "dateEnd"
            )
            .value;


    const abastecedor =
        document
            .getElementById(
                "filterAbastecedor"
            )
            .value;


    const local =
        document
            .getElementById(
                "filterLocal"
            )
            .value;


    const tipo =
        document
            .getElementById(
                "filterTipo"
            )
            .value;


    filteredData =
        rawData.filter(row=>{

            const rowDate =
                isoDate(row.data);


            if(
                start &&
                rowDate < start
            )
                return false;


            if(
                end &&
                rowDate > end
            )
                return false;


            if(
                abastecedor &&
                row.abastecedor !== abastecedor
            )
                return false;


            if(
                local &&
                row.local !== local
            )
                return false;


            if(
                tipo &&
                row.tipo !== tipo
            )
                return false;


            return true;

        });


    updateDashboard();

}


