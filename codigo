<script>


/* =====================================================
   VARIÃVEIS
===================================================== */

let rawData = [];

let filteredData = [];

let charts = {};


const COLORS = [

    "#8d83e6",
    "#55b99a",
    "#ed9d67",
    "#5d9bd8",
    "#df7898",
    "#d8b46a",
    "#9a8ac7",
    "#6db9b0",
    "#e7a5bd",
    "#7ea9cf"

];


/* =====================================================
   NORMALIZA TEXTO
===================================================== */

function normalize(value){

    return String(value ?? "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g,"")
        .trim()
        .toUpperCase();

}


/* =====================================================
   ESCAPA HTML
===================================================== */

function escapeHTML(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* =====================================================
   FORMATA MOEDA
===================================================== */

function money(value){

    return Number(value || 0)
        .toLocaleString(
            "pt-BR",
            {
                style:"currency",
                currency:"BRL"
            }
        );

}


/* =====================================================
   FORMATA NÃMERO
===================================================== */

function number(value){

    return Number(value || 0)
        .toLocaleString(
            "pt-BR",
            {
                maximumFractionDigits:2
            }
        );

}


/* =====================================================
   SOMA
===================================================== */

function sum(data,key){

    return data.reduce(
        (total,row)=>{

            return total +
                Number(row[key] || 0);

        },
        0
    );

}


/* =====================================================
   AGRUPAMENTO
===================================================== */

function groupBy(data,key){

    const result={};


    data.forEach(row=>{

        const value =
            String(row[key] || "")
            .trim() ||
            "NÃ£o informado";


        if(!result[value]){

            result[value]={

                qtd:0,

                custo:0,

                ocorrencias:0

            };

        }


        result[value].qtd +=
            Number(row.qtd || 0);


        result[value].custo +=
            Number(row.custo || 0);


        result[value].ocorrencias++;

    });


    return result;

}


/* =====================================================
   PARSE DE NÃMEROS
   CORREÃÃO PRINCIPAL
===================================================== */

function parseNumber(value){

    /*
     * CÃ©lula vazia
     */

    if(
        value === null ||
        value === undefined ||
        value === ""
    ){

        return 0;

    }


    /*
     * Valores negativos representados por "-"
     */

    if(
        typeof value === "string" &&
        value.trim() === "-"
    ){

        return 0;

    }


    /*
     * ==================================================
     * CORREÃÃO FUNDAMENTAL
     *
     * Quando o Excel entrega:
     *
     * 3.16
     *
     * isso jÃ¡ Ã© um nÃºmero decimal.
     *
     * NÃO devemos remover o ponto.
     * ==================================================
     */

    if(typeof value === "number"){

        return Number.isFinite(value)
            ? value
            : 0;

    }


    let text =
        String(value)
        .trim();


    if(!text)
        return 0;


    /*
     * Remove moeda e espaÃ§os.
     */

    text =
        text
        .replace(/R\$/gi,"")
        .replace(/\s/g,"")
        .replace(/[^\d,.\-]/g,"");


    if(!text)
        return 0;


    /*
     * Formato brasileiro:
     *
     * 1.234,56
     *
     * vira:
     *
     * 1234.56
     */

    if(
        text.includes(".") &&
        text.includes(",")
    ){

        text =
            text
            .replace(/\./g,"")
            .replace(",",".");
    }


    /*
     * Formato:
     *
     * 3,16
     */

    else if(text.includes(",")){

        text =
            text.replace(",",".");
    }


    /*
     * Formato:
     *
     * 3.16
     *
     * permanece 3.16.
     */

    const result =
        Number(text);


    return Number.isFinite(result)
        ? result
        : 0;

}


/* =====================================================
   PARSE DE DATA
===================================================== */

function parseDate(value){

    if(
        value === null ||
        value === undefined ||
        value === ""
    ){

        return null;

    }


    /*
     * Excel serial date
     */

    if(typeof value === "number"){

        const parsed =
            XLSX.SSF.parse_date_code(value);


        if(parsed){

            return new Date(
                parsed.y,
                parsed.m - 1,
                parsed.d
            );

        }


        return null;

    }


    /*
     * Date
     */

    if(value instanceof Date){

        return isNaN(value.getTime())
            ? null
            : value;

    }


    const text =
        String(value).trim();


    /*
     * DD/MM/YYYY
     */

    const br =
        text.match(
            /^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/
        );


    if(br){

        const day =
            Number(br[1]);

        const month =
            Number(br[2])-1;

        const year =
            Number(br[3]);


        const date =
            new Date(
                year,
                month,
                day
            );


        if(!isNaN(date.getTime()))
            return date;

    }


    /*
     * ISO ou outros formatos
     */

    const date =
        new Date(text);


    if(!isNaN(date.getTime()))
        return date;


    return null;

}


/* =====================================================
   ISO DATE
===================================================== */

function isoDate(date){

    if(!date)
        return "";


    const year =
        date.getFullYear();


    const month =
        String(
            date.getMonth()+1
        ).padStart(2,"0");


    const day =
        String(
            date.getDate()
        ).padStart(2,"0");


    return `${year}-${month}-${day}`;

}


/* =====================================================
   FORMATA DATA
===================================================== */

function formatDate(date){

    if(!date)
        return "";


    return date.toLocaleDateString(
        "pt-BR"
    );

}


