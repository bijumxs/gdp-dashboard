document
    .getElementById("fileInput")
    .addEventListener(
        "change",
        function(event){

            const file =
                event.target.files[0];


            if(!file)
                return;


            const status =
                document.getElementById("status");


            status.style.display="block";

            status.textContent =
                "Lendo a base de dados...";


            const reader =
                new FileReader();


            reader.onload =
                function(e){

                    try{

                        const workbook =
                            XLSX.read(
                                e.target.result,
                                {
                                    type:"array",
                                    cellDates:true
                                }
                            );


                        const data =
                            parseWorkbook(
                                workbook
                            );


                        if(!data.length){

                            status.textContent =
                                "Nenhum registro vÃ¡lido encontrado.";

                            return;

                        }


                        rawData=data;

                        filteredData=[
                            ...rawData
                        ];


                        setupFilters();


                        updateDashboard();


                        status.textContent =
                            `Base carregada com sucesso: ${
                                rawData.length.toLocaleString("pt-BR")
                            } registros.`;

                    }


