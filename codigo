/* =====================================================
   KPIs
===================================================== */

function updateKPIs(){

    const totalCost =
        sum(
            filteredData,
            "custo"
        );


    const totalQty =
        sum(
            filteredData,
            "qtd"
        );


    const occurrences =
        filteredData.length;


    const uniqueDays =
        new Set(
            filteredData.map(
                row=>isoDate(row.data)
            )
        ).size;


    const daily =
        uniqueDays
            ? totalCost / uniqueDays
            : 0;


    const average =
        occurrences
            ? totalCost / occurrences
            : 0;


    document
        .getElementById(
            "kpiCost"
        )
        .textContent =
        money(totalCost);


    document
        .getElementById(
            "kpiQty"
        )
        .textContent =
        number(totalQty);


    document
        .getElementById(
            "kpiOccurrences"
        )
        .textContent =
        number(occurrences);


    document
        .getElementById(
            "kpiDaily"
        )
        .textContent =
        money(daily);


    document
        .getElementById(
            "kpiAverage"
        )
        .textContent =
        money(average);


    document
        .getElementById(
            "kpiCostSub"
        )
        .textContent =
        uniqueDays
            ? `${uniqueDays} ${
                uniqueDays===1
                    ? "dia"
                    : "dias"
              } analisados`
            : "Nenhum registro";

}


