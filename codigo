===================================================== */

function updatePareto(){

    const container =
        document.getElementById(
            "paretoList"
        );


    container.innerHTML="";


    if(!filteredData.length){

        container.innerHTML=`

            <div class="empty">

                <div class="empty-icon">
                    ð
                </div>

                <div>
                    Nenhum dado para analisar.
                </div>

            </div>

        `;

        return;

    }


    const total =
        sum(
            filteredData,
            "custo"
        );


    const groups =
        groupBy(
            filteredData,
            "produto"
        );


    const entries =
        Object.entries(groups)
            .sort(
                (a,b)=>
                    b[1].custo -
                    a[1].custo
            )
            .slice(0,12);


    let accumulated=0;


    entries.forEach(
        ([product,data])=>{

            accumulated +=
                data.custo;


            const percentage =
                total
                    ? data.custo /
                      total *
                      100
                    : 0;


            const cumulative =
                total
                    ? accumulated /
                      total *
                      100
                    : 0;


            const row =
                document.createElement(
                    "div"
                );


            row.className=
                "pareto-row";


            const shortName =
                product.length>25
                    ? product.substring(
                        0,
                        25
                      )+"â¦"
                    : product;


            row.innerHTML=`

                <div title="${escapeHTML(product)}">
                    ${escapeHTML(shortName)}
                </div>

                <div class="bar">
                    <span
                        style="
                            width:${Math.min(
                                percentage,
                                100
                            )}%
                        "
                    ></span>
                </div>

                <div style="text-align:right">

                    ${percentage.toFixed(1)}%

                    <br>

                    <span
                        style="
                            font-size:9px;
                            color:#999
                        "
                    >
                        acum.
                        ${cumulative.toFixed(1)}%
                    </span>

                </div>

            `;


            container.appendChild(row);

        }
    );

}


/* =====================================================
   PRIORIDADE
===================================================== */

function updatePriority(){

    const groups =
        groupBy(
            filteredData,
            "produto"
        );


    const entries =
        Object.entries(groups)
            .map(
                ([name,data])=>({

                    name,

                    ...data

                })
            )
            .sort(
                (a,b)=>
                    b.custo -
                    a.custo
            );


    if(!entries.length){

        document.getElementById(
            "criticalText"
        ).textContent =
            "Nenhum dado.";

        document.getElementById(
            "attentionText"
        ).textContent =
            "Nenhum dado.";

        document.getElementById(
            "lowText"
        ).textContent =
            "Nenhum dado.";

        return;

    }


    const maxCost =
        entries[0].custo;


    const critical =
        entries.filter(
            x =>
                x.custo >=
                    maxCost * .60
                &&
                x.ocorrencias >= 3
        );


    const attention =
        entries.filter(
            x =>
                !critical.includes(x)
                &&
                (
                    x.custo >=
                        maxCost * .25
                    ||
                    x.ocorrencias >= 3
                )
        );


    const low =
        entries.filter(
            x =>
                !critical.includes(x)
                &&
                !attention.includes(x)
        );


    function names(list){

        if(!list.length)
            return "Nenhum item identificado.";


        return list
            .slice(0,4)
            .map(
                x=>x.name
            )
            .join(", ")
            +
            (
                list.length>4
                    ? "â¦"
                    : ""
            );

    }


    document.getElementById(
        "criticalText"
    ).textContent =
        names(critical);


    document.getElementById(
        "attentionText"
    ).textContent =
        names(attention);


    document.getElementById(
        "lowText"
    ).textContent =
        names(low);

}


