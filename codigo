/* =====================================================
   CONFIGURA FILTROS
===================================================== */

function setupFilters(){

    populateSelect(
        "filterAbastecedor",
        uniqueValues("abastecedor")
    );


    populateSelect(
        "filterLocal",
        uniqueValues("local")
    );


    populateSelect(
        "filterTipo",
        uniqueValues("tipo")
    );


    if(rawData.length){

        const dates =
            rawData
                .map(
                    row=>row.data
                )
                .filter(Boolean);


        if(dates.length){

            const minTime =
                Math.min(
                    ...dates.map(
                        d=>d.getTime()
                    )
                );


            const maxTime =
                Math.max(
                    ...dates.map(
                        d=>d.getTime()
                    )
                );


            const minDate =
                new Date(minTime);


            const maxDate =
                new Date(maxTime);


            document
                .getElementById(
                    "dateStart"
                )
                .value =
                isoDate(minDate);


            document
                .getElementById(
                    "dateEnd"
                )
                .value =
                isoDate(maxDate);

        }

    }

}


