/* =====================================================
   LÃ WORKBOOK
===================================================== */

function parseWorkbook(workbook){

    let bestSheet=null;

    let bestHeaderRow=-1;

    let bestHeader=null;


    /*
     * Procura a tabela operacional
     * em todas as abas.
     */

    workbook.SheetNames.forEach(
        sheetName=>{

            const sheet =
                workbook.Sheets[sheetName];


            const rows =
                XLSX.utils.sheet_to_json(
                    sheet,
                    {
                        header:1,
                        defval:""
                    }
                );


            for(
                let i=0;
                i<rows.length;
                i++
            ){

                const row =
                    rows[i].map(normalize);


                const hasAbastecedor =
                    row.includes("ABASTECEDOR");


                const hasLocal =
                    row.includes("LOCAL");


                const hasData =
                    row.includes("DATA");


                const hasProduto =
                    row.includes("PRODUTO") ||
                    row.includes("PRODUTO PRINCIPAL");


                const hasQuantidade =
                    row.includes("QUANT.") ||
                    row.includes("QUANT") ||
                    row.includes("QUANTIDADE");


                const hasTipo =
                    row.includes("TIPO");


                const hasCusto =
                    row.includes("CUSTO");


                if(
                    hasAbastecedor &&
                    hasLocal &&
                    hasData &&
                    hasProduto &&
                    hasQuantidade &&
                    hasTipo &&
                    hasCusto
                ){

                    bestSheet=sheet;

                    bestHeaderRow=i;

                    bestHeader=row;

                    break;

                }

            }

        }
    );


    if(
        !bestSheet ||
        bestHeaderRow===-1
    ){

        alert(
            "NÃ£o foi possÃ­vel localizar a tabela operacional.\n\n"+
            "A base precisa conter:\n"+
            "ABASTECEDOR, LOCAL, DATA, PRODUTO, QUANT., TIPO e CUSTO."
        );

        return [];

    }


    /*
     * Encontra coluna
     */

    function findColumn(names){

        for(const name of names){

            const index =
                bestHeader.indexOf(
                    normalize(name)
                );


            if(index!==-1)
                return index;

        }


        return -1;

    }


    const idx={

        abastecedor:
            findColumn([
                "ABASTECEDOR"
            ]),

        local:
            findColumn([
                "LOCAL"
            ]),

        data:
            findColumn([
                "DATA"
            ]),

        produto:
            findColumn([
                "PRODUTO",
                "PRODUTO PRINCIPAL"
            ]),

        qtd:
            findColumn([
                "QUANT.",
                "QUANT",
                "QUANTIDADE"
            ]),

        tipo:
            findColumn([
                "TIPO"
            ]),

        custo:
            findColumn([
                "CUSTO"
            ])

    };


    const rows =
        XLSX.utils.sheet_to_json(
            bestSheet,
            {
                header:1,
                defval:""
            }
        );


    const result=[];


    /*
     * ComeÃ§a somente depois do cabeÃ§alho
     */

    for(
        let i=bestHeaderRow+1;
        i<rows.length;
        i++
    ){

        const row=rows[i];


        /*
         * Data vÃ¡lida
         */

        const data =
            parseDate(
                row[idx.data]
            );


        /*
         * Sem data:
         * provavelmente Ã© ranking,
         * total ou Ã¡rea auxiliar.
         */

        if(!data)
            continue;


        const abastecedor =
            String(
                row[idx.abastecedor] ?? ""
            ).trim();


        const local =
            String(
                row[idx.local] ?? ""
            ).trim();


        const produto =
            String(
                row[idx.produto] ?? ""
            ).trim();


        const tipo =
            String(
                row[idx.tipo] ?? ""
            ).trim();


        /*
         * Produto obrigatÃ³rio
         */

        if(!produto)
            continue;


        const qtd =
            parseNumber(
                row[idx.qtd]
            );


        const custo =
            parseNumber(
                row[idx.custo]
            );


        result.push({

            abastecedor:
                abastecedor ||
                "NÃ£o informado",

            local:
                local ||
                "NÃ£o informado",

            data:data,

            produto:
                produto ||
                "NÃ£o informado",

            qtd:qtd,

            tipo:
                tipo ||
                "NÃ£o informado",

            custo:custo

        });

    }


    /*
     * Log para conferÃªncia
     */

    console.log(
        "================================="
    );

    console.log(
        "DASHBOARD - BASE CARREGADA"
    );

    console.log(
        "Registros:",
        result.length
    );

    console.log(
        "Quantidade:",
        sum(result,"qtd")
    );

    console.log(
        "Custo:",
        sum(result,"custo")
    );

    console.log(
        "================================="
    );


    return result;

}


